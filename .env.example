# Sagolik Close — environment. Copy to apps/web/.env.local (and export for the worker).
# Never commit real values. Leave a value empty to use the clearly-labelled sandbox adapter.
# With no Supabase values the app runs in DEMO MODE: in-memory store, fictional data, sandbox providers.

APP_ENV=local                       # local | development | staging | production
APP_URL=http://localhost:3000
# DEMO_MODE=true                    # force demo mode even with Supabase configured (never in production)
# DEMO_RESET_HOURS=6                # public demo: rebuild the fictional environment every N hours (0 = never)

# --- Supabase (auth, Postgres with RLS, storage) -----------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only; bypasses RLS — used by services/worker, never sent to browsers

# --- Or PostgreSQL directly: Azure Database for PostgreSQL (docs/azure) -------
# Never together with Supabase. People's reads run as `authenticated` with their
# claims (row-level security); the service layer writes as `service_role`.
# Apply migrations with: pnpm --filter @sagolik/worker migrate
DATABASE_URL=                       # postgres://<login>@<host>:5432/<db>?sslmode=verify-full (verify-full required outside local)
DATABASE_AUTH=password              # password | entra (the managed identity signs in with Entra tokens; no password anywhere)
AZURE_CLIENT_ID=                    # the workload's user-assigned managed identity
AZURE_STORAGE_BLOB_URL=             # https://<account>.blob.core.windows.net — documents (required outside local)
AZURE_STORAGE_CONTAINER=documents

# --- Secrets (required in production; local fallbacks are refused there) ------
# 32-byte keys, base64, comma-separated, newest first:  v2:<b64>,v1:<b64>
#   node -e "console.log('v1:'+require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEYS=
# Or, on Azure, the same keys wrapped by a Key Vault key and unwrapped in memory at start-up
# (pnpm --filter @sagolik/worker keys new-data-key v1 <key id>). Never both.
DATA_KEYS_WRAPPED=                  # v2:<b64 wrapped>,v1:<b64 wrapped>
DATA_KEK_ID=                        # https://<vault>.vault.azure.net/keys/data-kek
SESSION_SECRET=                     # ≥32 random characters — required on every non-local APP_ENV
                                    #   openssl rand -hex 32

# --- Open banking (Plaid) ----------------------------------------------------
# Without the money service, the web app talks to Plaid itself (Hosted Link;
# Identity + Balance only). Free sandbox keys: dashboard.plaid.com → Developers → Keys.
# With MONEY_SERVICE_URL set, leave these empty and configure MONEY_PLAID_* on
# the money service instead, so access tokens never reach the web app.
# Webhooks: point Plaid at ${APP_URL}/api/webhooks/plaid (verified with Plaid's signed JWT).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox                   # sandbox | production (production needs approved Plaid production access)
# Property Autopilot, opt-in and read-only: comma-separated "transactions" and/or
# "liabilities". Requested as Plaid optional products (billed by Plaid once used).
# Leave empty to never read transactions or lender data.
PLAID_OPTIONAL_PRODUCTS=
TRUELAYER_CLIENT_ID=                # reserved: EU adapter not yet implemented
TRUELAYER_CLIENT_SECRET=

# --- Deal record and wallet proof of funds on Base (record and verify only) ----
# Nothing here can move money. Default: an in-memory sandbox chain in demo mode, off otherwise.
# See docs/onchain.md for deploying the registry (signed by the treasury wallet, never a key in this file).
CHAIN_NETWORK=                      # off | sandbox | base-sepolia | base | local (production: base or off)
CHAIN_RPC_URL=                      # https JSON-RPC endpoint; defaults to the public (rate-limited) Base endpoint
CHAIN_REGISTRY_ADDRESS=             # deployed SagolikDealRegistry
CHAIN_DEAL_SALT=                    # ≥32 random characters; keep stable (openssl rand -hex 32)
CHAIN_RECORDER_KEY=                 # test networks: the RECORDER_ROLE account's key (it can only append fingerprints)
CHAIN_RECORDER_KEY_ID=              # production: a Key Vault secp256k1 key that signs inside the HSM (never both)
# CHAIN_USDC_ADDRESS=               # local test networks only

# --- Reserved for production adapters (interfaces + sandbox exist; see docs/provider-adapters.md)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PERSONA_API_KEY=
PERSONA_WEBHOOK_SECRET=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_WEBHOOK_SECRET=

# --- Messaging ---------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Sagolik Close <no-reply@close.sagolik.com>"
CONTACT_INBOX=                      # where contact-form enquiries are delivered (works in demo mode too)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# --- Sandbox providers -------------------------------------------------------
MOCK_WEBHOOK_SECRET=mock_webhook_secret_local_only

# --- Go money service (services/money) — optional ---------------------------
# When set, payment instructions and escrow-reported movements live in the money
# service; the web app keeps masked copies only. See services/money/README.md.
MONEY_SERVICE_URL=                  # https://money.internal:8443
MONEY_SERVICE_CA_FILE=              # internal CA that signed the money service certificate
MONEY_SERVICE_CERT_FILE=            # this app's client certificate (URI SAN spiffe://sagolik/web)
MONEY_SERVICE_KEY_FILE=
MONEY_ASSERTION_SIGNING_JWK_FILE=   # Ed25519 private JWK; publish its public half to the money service's JWKS
MONEY_ASSERTION_KID=web-1

# --- Worker ------------------------------------------------------------------
WORKER_INTERVAL_MS=2000
